{% set detected_os = detect_api.detect_os() %}
{% set detected_arch = detect_api.detect_arch() %}
{% set _, detected_clang_version, _ = detect_api.detect_clang_compiler("clang") %}
{% set clang_major_version = (detected_clang_version|string).split(".")[0] %}
{% set gcc_libstdcxx = subprocess.check_output(["gcc", "-print-file-name=libstdc++.so"], text=True).strip() %}
{% if "/" not in gcc_libstdcxx %}
{% set _ = subprocess.check_call(["/bin/sh", "-c", "printf '%s\n' 'gcc could not locate libstdc++.so; install g++/libstdc++ development files or set a proper GCC toolchain' >&2; exit 1"]) %}
{% endif %}
{% set gcc_install_dir = gcc_libstdcxx.rsplit("/", 1)[0] %}

[settings]
os={{ detected_os }}
arch={{ detected_arch }}
compiler=clang
compiler.version={{ clang_major_version }}
compiler.libcxx=libstdc++11
compiler.cppstd=17
build_type=Release

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:compiler_executables={"c": "clang", "cpp": "clang++"}
tools.build:cxxflags=["--gcc-install-dir={{ gcc_install_dir }}"]
tools.build:jobs=4
