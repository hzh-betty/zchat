{
  "server": {
    "http_port": 8000,
    "websocket_port": 8001
  },
  "services": {
    "user": 10003,
    "file": 10002,
    "speech": 10001,
    "transmite": 10004,
    "message": 10005,
    "friend": 10006
  },
  "mysql": {
    "host": "127.0.0.1",
    "port": 3306,
    "database": "zchat",
    "user": "{{ZCHAT_MYSQL_USER}}",
    "password": "{{ZCHAT_MYSQL_PASSWORD}}",
    "charset": "utf8mb4",
    "connections": 4
  },
  "redis": {
    "host": "127.0.0.1",
    "port": 6379,
    "database": 0,
    "password": "{{ZCHAT_REDIS_PASSWORD}}",
    "connections": 2
  },
  "storage": {
    "path": "./server_storage"
  },
  "speech": {
    "app_id": "{{ZCHAT_SPEECH_APP_ID}}",
    "api_key": "{{ZCHAT_SPEECH_API_KEY}}",
    "secret_key": "{{ZCHAT_SPEECH_SECRET_KEY}}"
  },
  "elasticsearch": {
    "hosts": "http://127.0.0.1:9200/",
    "user": "",
    "password": ""
  },
  "rabbitmq": {
    "host": "127.0.0.1:5672",
    "user": "{{ZCHAT_RABBITMQ_USER}}",
    "password": "{{ZCHAT_RABBITMQ_PASSWORD}}",
    "exchange": "msg_exchange",
    "queue": "msg_queue",
    "routing_key": "msg_queue"
  },
  "sms": {
    "access_key_id": "{{ZCHAT_SMS_ACCESS_KEY_ID}}",
    "access_key_secret": "{{ZCHAT_SMS_ACCESS_KEY_SECRET}}",
    "sign_name": "{{ZCHAT_SMS_SIGN_NAME}}",
    "template_code": "{{ZCHAT_SMS_TEMPLATE_CODE}}"
  }
}
