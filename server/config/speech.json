{
  "services": {
    "speech": 10001
  },
  "etcd": {
    "endpoints": "http://{{ZCHAT_ETCD_HOST}}:2379",
    "base_path": "/service",
    "advertise_host": "{{ZCHAT_ADVERTISE_HOST}}",
    "username": "{{ZCHAT_ETCD_USERNAME}}",
    "password": "{{ZCHAT_ETCD_PASSWORD}}",
    "lease_ttl_seconds": 3,
    "auth_token_ttl_seconds": 300
  },
  "speech": {
    "app_id": "{{ZCHAT_SPEECH_APP_ID}}",
    "api_key": "{{ZCHAT_SPEECH_API_KEY}}",
    "secret_key": "{{ZCHAT_SPEECH_SECRET_KEY}}"
  }
}