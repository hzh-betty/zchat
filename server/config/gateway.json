{
  "log": {
    "level": "debug",
    "console": true,
    "file": true,
    "file_path": "./logs/gateway.log",
    "max_file_size": 52428800,
    "max_files": 5,
    "format": "[%n][%Y-%m-%d %H:%M:%S.%e][%t][%-8l]%v"
  },
  "server": {
    "http_port": "{{ZCHAT_GATEWAY_HTTP_PORT}}",
    "websocket_port": "{{ZCHAT_GATEWAY_WEBSOCKET_PORT}}"
  },
  "redis": {
    "host": "{{ZCHAT_REDIS_HOST}}",
    "port": "{{ZCHAT_REDIS_PORT}}",
    "database": 0,
    "password": "{{secret_file:ZCHAT_REDIS_PASSWORD_FILE}}",
    "connections": 2
  },
  "etcd": {
    "endpoints": "https://{{ZCHAT_ETCD_HOST}}:{{ZCHAT_ETCD_PORT}}",
    "base_path": "/service",
    "advertise_host": "{{ZCHAT_ADVERTISE_HOST}}",
    "username": "{{ZCHAT_ETCD_USERNAME}}",
    "password": "{{secret_file:ZCHAT_ETCD_PASSWORD_FILE}}",
    "lease_ttl_seconds": 10,
    "auth_token_ttl_seconds": 300,
    "tls": {
      "enable": true,
      "ca_path": "{{ZCHAT_GRPC_CA_PATH}}",
      "cert_path": "{{ZCHAT_GRPC_CERT_PATH}}",
      "key_path": "{{ZCHAT_GRPC_KEY_PATH}}",
      "target_name_override": "etcd"
    }
  }
}
