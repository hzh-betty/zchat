{
  "server": {
    "http_port": 8000,
    "websocket_port": 8001
  },
  "redis": {
    "host": "{{ZCHAT_REDIS_HOST}}",
    "port": 6379,
    "database": 0,
    "password": "{{ZCHAT_REDIS_PASSWORD}}",
    "connections": 2
  },
  "etcd": {
    "endpoints": "http://{{ZCHAT_ETCD_HOST}}:2379",
    "base_path": "/service",
    "advertise_host": "{{ZCHAT_ADVERTISE_HOST}}",
    "username": "{{ZCHAT_ETCD_USERNAME}}",
    "password": "{{ZCHAT_ETCD_PASSWORD}}",
    "lease_ttl_seconds": 3,
    "auth_token_ttl_seconds": 300
  }
}