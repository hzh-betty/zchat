{
  "log": {
    "level": "info",
    "console": true,
    "file": true,
    "file_path": "./logs/user.log",
    "max_file_size": 52428800,
    "max_files": 5,
    "format": "[%n][%Y-%m-%d %H:%M:%S.%e][%t][%-8l]%v"
  },
  "services": {
    "user": "{{ZCHAT_USER_SERVICE_PORT}}"
  },
  "mysql": {
    "host": "{{ZCHAT_MYSQL_HOST}}",
    "port": "{{ZCHAT_MYSQL_PORT}}",
    "database": "{{MYSQL_DATABASE}}",
    "user": "{{MYSQL_USER}}",
    "password": "{{secret_file:MYSQL_PASSWORD_FILE}}",
    "charset": "utf8mb4",
    "connections": 16
  },
  "redis": {
    "host": "{{ZCHAT_REDIS_HOST}}",
    "port": "{{ZCHAT_REDIS_PORT}}",
    "database": 0,
    "password": "{{secret_file:ZCHAT_REDIS_PASSWORD_FILE}}",
    "connections": 8
  },
  "etcd": {
    "endpoints": "https://{{ZCHAT_ETCD_HOST}}:{{ZCHAT_ETCD_PORT}}",
    "base_path": "/service",
    "advertise_host": "{{ZCHAT_ADVERTISE_HOST}}",
    "username": "{{ZCHAT_ETCD_USERNAME}}",
    "password": "{{secret_file:ZCHAT_ETCD_PASSWORD_FILE}}",
    "lease_ttl_seconds": 10,
    "auth_token_ttl_seconds": 300,
    "tls": {
      "enable": true,
      "ca_path": "{{ZCHAT_GRPC_CA_PATH}}",
      "cert_path": "{{ZCHAT_GRPC_CERT_PATH}}",
      "key_path": "{{ZCHAT_GRPC_KEY_PATH}}",
      "target_name_override": "etcd"
    }
  },
  "elasticsearch": {
    "hosts": "https://{{ZCHAT_ES_HOST}}:{{ZCHAT_ES_PORT}}/",
    "user": "{{ZCHAT_ELASTICSEARCH_USER}}",
    "password": "{{secret_file:ZCHAT_ELASTICSEARCH_PASSWORD_FILE}}",
    "tls": {
      "enable": true,
      "ca_path": "{{ZCHAT_GRPC_CA_PATH}}"
    }
  },
  "sms": {
    "access_key_id": "{{secret_file:ZCHAT_SMS_ACCESS_KEY_ID_FILE}}",
    "access_key_secret": "{{secret_file:ZCHAT_SMS_ACCESS_KEY_SECRET_FILE}}",
    "sign_name": "{{ZCHAT_SMS_SIGN_NAME}}",
    "template_code": "{{ZCHAT_SMS_TEMPLATE_CODE}}"
  },
  "grpc": {
    "bind_address": "0.0.0.0",
    "num_cqs": 2,
    "min_pollers": 4,
    "max_pollers": 32,
    "cq_timeout_msec": 10000,
    "max_send_message_size": 4194304,
    "max_receive_message_size": 4194304,
    "tls": {
      "enable": true,
      "ca_path": "{{ZCHAT_GRPC_CA_PATH}}",
      "cert_path": "{{ZCHAT_GRPC_CERT_PATH}}",
      "key_path": "{{ZCHAT_GRPC_KEY_PATH}}"
    }
  }
}
