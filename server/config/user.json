{
  "services": {
    "user": 10003
  },
  "mysql": {
    "host": "{{ZCHAT_MYSQL_HOST}}",
    "port": 3306,
    "database": "zchat",
    "user": "{{ZCHAT_MYSQL_USER}}",
    "password": "{{ZCHAT_MYSQL_PASSWORD}}",
    "charset": "utf8mb4",
    "connections": 4
  },
  "redis": {
    "host": "{{ZCHAT_REDIS_HOST}}",
    "port": 6379,
    "database": 0,
    "password": "{{ZCHAT_REDIS_PASSWORD}}",
    "connections": 2
  },
  "etcd": {
    "endpoints": "http://{{ZCHAT_ETCD_HOST}}:2379",
    "base_path": "/service",
    "advertise_host": "{{ZCHAT_ADVERTISE_HOST}}",
    "username": "{{ZCHAT_ETCD_USERNAME}}",
    "password": "{{ZCHAT_ETCD_PASSWORD}}",
    "lease_ttl_seconds": 3,
    "auth_token_ttl_seconds": 300
  },
  "elasticsearch": {
    "hosts": "http://{{ZCHAT_ES_HOST}}:9200/",
    "user": "{{ZCHAT_ELASTICSEARCH_USER}}",
    "password": "{{ZCHAT_ELASTICSEARCH_PASSWORD}}"
  },
  "sms": {
    "access_key_id": "{{ZCHAT_SMS_ACCESS_KEY_ID}}",
    "access_key_secret": "{{ZCHAT_SMS_ACCESS_KEY_SECRET}}",
    "sign_name": "{{ZCHAT_SMS_SIGN_NAME}}",
    "template_code": "{{ZCHAT_SMS_TEMPLATE_CODE}}"
  }
}