{
  "services": {
    "user": "{{ZCHAT_USER_SERVICE_PORT}}"
  },
  "mysql": {
    "host": "{{ZCHAT_MYSQL_HOST}}",
    "port": "{{ZCHAT_MYSQL_PORT}}",
    "database": "{{MYSQL_DATABASE}}",
    "user": "{{MYSQL_USER}}",
    "password": "{{secret_file:MYSQL_PASSWORD_FILE}}",
    "charset": "utf8mb4",
    "connections": 4
  },
  "redis": {
    "host": "{{ZCHAT_REDIS_HOST}}",
    "port": "{{ZCHAT_REDIS_PORT}}",
    "database": 0,
    "password": "{{secret_file:ZCHAT_REDIS_PASSWORD_FILE}}",
    "connections": 2
  },
  "etcd": {
    "endpoints": "http://{{ZCHAT_ETCD_HOST}}:{{ZCHAT_ETCD_PORT}}",
    "base_path": "/service",
    "advertise_host": "{{ZCHAT_ADVERTISE_HOST}}",
    "username": "{{ZCHAT_ETCD_USERNAME}}",
    "password": "{{secret_file:ZCHAT_ETCD_PASSWORD_FILE}}",
    "lease_ttl_seconds": 3,
    "auth_token_ttl_seconds": 300
  },
  "elasticsearch": {
    "hosts": "http://{{ZCHAT_ES_HOST}}:{{ZCHAT_ES_PORT}}/",
    "user": "{{ZCHAT_ELASTICSEARCH_USER}}",
    "password": "{{secret_file:ZCHAT_ELASTICSEARCH_PASSWORD_FILE}}"
  },
  "sms": {
    "access_key_id": "{{secret_file:ZCHAT_SMS_ACCESS_KEY_ID_FILE}}",
    "access_key_secret": "{{secret_file:ZCHAT_SMS_ACCESS_KEY_SECRET_FILE}}",
    "sign_name": "{{ZCHAT_SMS_SIGN_NAME}}",
    "template_code": "{{ZCHAT_SMS_TEMPLATE_CODE}}"
  }
}
