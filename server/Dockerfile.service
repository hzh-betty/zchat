# ==========================================
# Common Conan/CMake service image
# ==========================================
FROM ubuntu:22.04 AS conan-deps

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    cmake \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
    git \
    && rm -rf /var/lib/apt/lists/*

ENV CC=clang
ENV CXX=clang++

RUN pip3 install "conan>=2.28"

WORKDIR /app
COPY conanfile.py .
COPY profiles ./profiles

ARG BUILD_PRESET=conan2-release

RUN if [ "$BUILD_PRESET" = "conan2-debug" ] ; then \
        conan install . --output-folder=/app/build/${BUILD_PRESET} --build=missing -pr:h profiles/linux-clang-debug -pr:b profiles/linux-clang-release ; \
    else \
        conan install . --output-folder=/app/build/${BUILD_PRESET} --build=missing -pr:h profiles/linux-clang-release -pr:b profiles/linux-clang-release ; \
    fi

FROM conan-deps AS builder

ARG BUILD_PRESET=conan2-release

COPY CMakeLists.txt ./
COPY server/src ./server/src
COPY server/proto ./server/proto
COPY server/config ./server/config
COPY server/cmake ./server/cmake
COPY server/CMakeLists.txt ./server/CMakeLists.txt

RUN if [ "$BUILD_PRESET" = "conan2-debug" ] ; then \
        host_profile=profiles/linux-clang-debug ; \
    else \
        host_profile=profiles/linux-clang-release ; \
    fi \
    && conan build . \
        --output-folder=/app/build/${BUILD_PRESET} \
        -pr:h $host_profile \
        -pr:b profiles/linux-clang-release \
        -c tools.build:jobs=4 \
    && mkdir -p /app/lib/plugin \
    && find /root/.conan2 -path '*/lib/plugin/*.so' -exec cp -L {} /app/lib/plugin/ \;

# ==========================================
# Runner
# ==========================================
FROM ubuntu:22.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libstdc++6 \
    libuuid1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG BUILD_PRESET=conan2-release

ENV MARIADB_PLUGIN_DIR=/app/lib/plugin

COPY --from=builder /app/build/${BUILD_PRESET}/bin /app/bin
COPY --from=builder /app/lib/plugin /app/lib/plugin
COPY --from=builder /app/server/config /app/server/config

CMD ["/bin/sh", "-c", "exec /app/bin/${SERVICE_BINARY}"]
