# ==========================================
# Common Conan/CMake service image
# ==========================================
FROM ubuntu:22.04 AS conan-deps

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    cmake \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
    git \
    && rm -rf /var/lib/apt/lists/*

ENV CC=clang
ENV CXX=clang++

RUN pip3 install "conan>=2.28"

WORKDIR /app
COPY conanfile.py .
COPY profiles ./profiles

ARG BUILD_PRESET=conan2-release

RUN if [ "$BUILD_PRESET" = "conan2-debug" ] ; then \
        conan install . --build=missing -pr:h profiles/linux-clang-debug -pr:b profiles/linux-clang-release ; \
    else \
        conan install . --build=missing -pr:h profiles/linux-clang-release -pr:b profiles/linux-clang-release ; \
    fi

FROM conan-deps AS builder

ARG BUILD_PRESET=conan2-release
ARG SERVICE_TARGET

COPY CMakeLists.txt CMakePresets.json ./
COPY server ./server

RUN cmake --preset ${BUILD_PRESET} \
    && cmake --build --preset ${BUILD_PRESET} --target ${SERVICE_TARGET} -j1

# ==========================================
# Runner
# ==========================================
FROM ubuntu:22.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libuuid1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG BUILD_PRESET=conan2-release
ARG SERVICE_BINARY
ARG SERVICE_CONFIG

ENV SERVICE_BINARY=${SERVICE_BINARY}

COPY --from=builder /app/build/${BUILD_PRESET}/bin/${SERVICE_BINARY} /app/bin/${SERVICE_BINARY}
COPY --from=builder /app/server/config/${SERVICE_CONFIG} /app/server/config/${SERVICE_CONFIG}

CMD ["/bin/sh", "-c", "exec /app/bin/${SERVICE_BINARY}"]
