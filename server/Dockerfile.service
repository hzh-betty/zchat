# syntax=docker/dockerfile:1
FROM ubuntu:26.04 AS toolchain

ARG UBUNTU_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/ubuntu
ARG PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV DEBIAN_FRONTEND=noninteractive CC=clang-21 CXX=clang++-21
RUN sed -i \
    -e "s|http://archive.ubuntu.com/ubuntu/|${UBUNTU_MIRROR}/|g" \
    -e "s|http://security.ubuntu.com/ubuntu/|${UBUNTU_MIRROR}/|g" \
    /etc/apt/sources.list.d/ubuntu.sources
RUN --mount=type=cache,id=zchat-apt-lists-resolute,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=zchat-apt-packages-resolute,target=/var/cache/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        build-essential clang-21 gcc-15 g++-15 cmake ninja-build \
        pkg-config python3 python3-venv git ca-certificates

ENV PATH=/opt/conan-venv/bin:$PATH
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m venv /opt/conan-venv \
    && pip install --index-url "${PYPI_INDEX_URL}" "conan==2.29.0"

FROM toolchain AS builder
WORKDIR /app
ARG BUILD_PRESET=conan2-release
ARG BUILD_JOBS=4
ARG TARGETARCH

COPY conanfile.py conan.lock CMakeLists.txt ./
COPY conan/deployers ./conan/deployers
COPY profiles ./profiles
COPY server/CMakeLists.txt ./server/CMakeLists.txt
COPY server/proto ./server/proto
COPY server/src ./server/src
COPY server/scripts/build-image.sh ./server/scripts/build-image.sh

RUN --mount=type=cache,id=zchat-conan-cache,target=/root/.conan2,sharing=locked \
    --mount=type=cache,id=zchat-build-clang21-${TARGETARCH}-${BUILD_PRESET},target=/app/build,sharing=locked \
    sh server/scripts/build-image.sh

FROM ubuntu:26.04 AS runner
ARG UBUNTU_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/ubuntu
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i \
    -e "s|http://archive.ubuntu.com/ubuntu/|${UBUNTU_MIRROR}/|g" \
    -e "s|http://security.ubuntu.com/ubuntu/|${UBUNTU_MIRROR}/|g" \
    /etc/apt/sources.list.d/ubuntu.sources
RUN --mount=type=cache,id=zchat-apt-lists-resolute,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=zchat-apt-packages-resolute,target=/var/cache/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        ca-certificates libstdc++6 libuuid1

WORKDIR /app
ENV MARIADB_PLUGIN_DIR=/app/lib/plugin LD_LIBRARY_PATH=/app/lib
COPY --from=builder /app/runtime/ /app/

COPY server/config ./server/config
CMD ["/bin/sh", "-c", "exec /app/bin/${SERVICE_BINARY}"]
